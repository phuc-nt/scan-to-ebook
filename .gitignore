# Secrets / credentials (never commit)
.env
.env.*
!.env.example
*.key
*.pem
rclone.conf

# Pipeline output / state
inbox/
output/
*.epub
*.md.bak

# Test data (scanned images ~180MB) + generated OCR output
tests/input/
tests/output*/

# Agent config / working dirs (local only)
.claude/
plans/
CLAUDE.md
/AGENTS.md

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/
