# Public demo/review outputs (curated, intentionally tracked despite *.epub / output/ above)
!samples/
!samples/**

# Personal illustration prompts (contain copyrighted story summaries: keep out of public repo)
docs/illustration-prompts/

# Personal ops docs (local machine paths, drive layout, cross-repo coordination)
docs/private/

# Dev journals (narrate real scanning runs — local history, not for the public remote)
docs/journals/
